# NEXT_PUBLIC_OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
NEXT_PUBLIC_OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for OAuth redirects and self-referential links
NEXT_PUBLIC_APP_URL="https://arquiv.org"

# Admin Configuration
ADMIN_EMAIL="admin email"

# Supabase Configuration
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY is optional (not used if relying on authenticated user sessions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Search Console API Configuration
# Create a service account in Google Cloud Console and download the JSON key
GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_PROPERTY_URL="https://arquiv.org"
GOOGLE_SITE_VERIFICATION="google-xxx"
